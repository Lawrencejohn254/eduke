# ── Supabase (required) ──────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role key — used only server-side (seed script, admin operations). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Groq (AI Teaching Assistant) — optional ──────────────────────────
# Without this, the AI Assistant works in demo mode with realistic mock content.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ── Pesapal (fee payments) — optional ────────────────────────────────
# Without these, fee payments use a simulated M-Pesa checkout screen.
# Sandbox credentials: https://developer.pesapal.com
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret

# ── Africa's Talking (SMS) — optional ────────────────────────────────
# Without these, SMS sends are logged to the server console instead of actually sending.
# Get credentials at https://africastalking.com
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=EduKe
